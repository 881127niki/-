<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>網課觀看紀錄系統</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', 'Noto Sans TC', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            -webkit-tap-highlight-color: transparent;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 2px;
        }

        /* Safe area padding for modern mobile browsers */
        .pb-safe {
            padding-bottom: env(safe-area-inset-bottom, 1rem);
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-modal {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .tab-btn.active {
            color: #38bdf8;
            background-color: rgba(56, 189, 248, 0.1);
            border-color: rgba(56, 189, 248, 0.3);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col pb-24 md:pb-8">

    <!-- Top Header -->
    <header class="sticky top-0 z-30 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3 sm:px-6">
        <div class="max-w-5xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20 text-white font-bold">
                    <i data-lucide="graduation-cap" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
                        網課觀看紀錄
                        <span class="text-[10px] bg-sky-500/20 text-sky-400 border border-sky-500/30 px-2 py-0.5 rounded-full font-medium">行動支援</span>
                    </h1>
                    <p class="text-xs text-slate-400">警察特考 / 法律課程進度管理</p>
                </div>
            </div>

            <!-- Sync & Reset Tools -->
            <div class="flex items-center gap-2">
                <button onclick="openSyncModal()" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-sky-400 text-xs font-medium flex items-center gap-1.5 transition-all active:scale-95">
                    <i data-lucide="arrow-left-right" class="w-3.5 h-3.5"></i>
                    <span class="hidden sm:inline">跨裝置</span>同步/備份
                </button>
                <button onclick="confirmReset()" class="p-1.5 rounded-lg bg-slate-800/80 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700 transition-all" title="重置預設資料">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto w-full px-4 pt-4 flex-1 space-y-5">

        <!-- Total Progress Dashboard -->
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-800 via-slate-800/90 to-indigo-950/60 p-5 border border-slate-700/80 shadow-xl">
            <div class="absolute -right-8 -bottom-8 text-slate-700/20 pointer-events-none">
                <i data-lucide="award" class="w-48 h-48"></i>
            </div>

            <div class="relative z-10 space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <span class="text-xs font-semibold text-sky-400 uppercase tracking-wider">整體完課總覽</span>
                        <h2 class="text-xl sm:text-2xl font-black text-white mt-0.5">總學習進度</h2>
                    </div>
                    <div class="text-right">
                        <span id="total-percentage-text" class="text-2xl sm:text-3xl font-black text-sky-400">0%</span>
                    </div>
                </div>

                <!-- Main Progress Bar -->
                <div class="space-y-1.5">
                    <div class="w-full bg-slate-900/80 rounded-full h-3.5 overflow-hidden p-0.5 border border-slate-700/60 shadow-inner">
                        <div id="total-progress-bar" class="h-full rounded-full bg-gradient-to-r from-sky-400 via-indigo-500 to-emerald-400 transition-all duration-500" style="width: 0%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-400 font-medium">
                        <span>已完成：<strong id="total-completed" class="text-white">0</strong> 堂</span>
                        <span>總堂數：<strong id="total-lessons" class="text-slate-300">0</strong> 堂</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Grid & Mobile Tabs View -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

            <!-- Mobile Quick Tab Switches (Hidden on LG) -->
            <div class="lg:hidden flex bg-slate-900/80 p-1 rounded-xl border border-slate-800 text-xs font-medium text-slate-400">
                <button onclick="switchMobileTab('courses')" id="tab-btn-courses" class="tab-btn active flex-1 py-2 rounded-lg flex items-center justify-center gap-1.5 transition-all">
                    <i data-lucide="book-open" class="w-3.5 h-3.5"></i>
                    科目進度
                </button>
                <button onclick="switchMobileTab('record')" id="tab-btn-record" class="tab-btn flex-1 py-2 rounded-lg flex items-center justify-center gap-1.5 transition-all">
                    <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                    填寫紀錄
                </button>
                <button onclick="switchMobileTab('history')" id="tab-btn-history" class="tab-btn flex-1 py-2 rounded-lg flex items-center justify-center gap-1.5 transition-all">
                    <i data-lucide="history" class="w-3.5 h-3.5"></i>
                    歷史紀錄
                </button>
            </div>

            <!-- Left Column / Tab Section: Add Form & History (5 Cols) -->
            <div id="section-left" class="lg:col-span-5 space-y-5 hidden lg:block">

                <!-- Log Entry Form Card -->
                <div id="form-card" class="glass-card rounded-2xl p-4 sm:p-5">
                    <div class="flex items-center gap-2 pb-3 mb-3 border-b border-slate-700/60">
                        <div class="p-1.5 rounded-lg bg-sky-500/10 text-sky-400">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        </div>
                        <h3 class="font-bold text-white text-sm">新增觀看紀錄</h3>
                    </div>

                    <form id="record-form" onsubmit="handleAddRecord(event)" class="space-y-3.5">
                        <div>
                            <label for="course-select" class="block text-xs font-medium text-slate-300 mb-1">選擇科目</label>
                            <select id="course-select" required class="w-full text-xs sm:text-sm bg-slate-900 border border-slate-700 rounded-xl px-3 py-2.5 text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all">
                                <!-- Dynamically populated -->
                            </select>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label for="record-date" class="block text-xs font-medium text-slate-300 mb-1">日期</label>
                                <input type="date" id="record-date" required class="w-full text-xs sm:text-sm bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all">
                            </div>
                            <div>
                                <label for="record-count" class="block text-xs font-medium text-slate-300 mb-1">觀看堂數 (+1)</label>
                                <input type="number" id="record-count" min="1" max="100" value="1" required class="w-full text-xs sm:text-sm bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all">
                            </div>
                        </div>

                        <button type="submit" class="w-full bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 active:scale-[0.98] text-white font-bold text-xs sm:text-sm py-2.5 rounded-xl shadow-lg shadow-sky-500/20 transition-all flex items-center justify-center gap-2">
                            <i data-lucide="check" class="w-4 h-4"></i>
                            加入並更新進度
                        </button>
                    </form>
                </div>

                <!-- History Logs Card -->
                <div id="history-card" class="glass-card rounded-2xl p-4 sm:p-5 flex flex-col h-[400px]">
                    <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-700/60">
                        <div class="flex items-center gap-2">
                            <div class="p-1.5 rounded-lg bg-indigo-500/10 text-indigo-400">
                                <i data-lucide="history" class="w-4 h-4"></i>
                            </div>
                            <h3 class="font-bold text-white text-sm">歷史觀看紀錄</h3>
                        </div>
                        <span id="history-count" class="text-[11px] bg-slate-800 text-slate-300 border border-slate-700 px-2 py-0.5 rounded-full">0 筆</span>
                    </div>

                    <!-- Search -->
                    <div class="mb-3">
                        <div class="relative">
                            <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-2.5 text-slate-400"></i>
                            <input type="text" id="history-search" oninput="renderHistory()" placeholder="搜尋歷史紀錄..." class="w-full text-xs pl-8 pr-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-200 focus:outline-none focus:border-sky-500">
                        </div>
                    </div>

                    <!-- History List -->
                    <div class="flex-1 overflow-y-auto pr-1 space-y-2" id="history-list">
                        <!-- Dynamic history logs -->
                    </div>
                </div>

            </div>

            <!-- Right Column / Tab Section: Courses Progress (7 Cols) -->
            <div id="section-right" class="lg:col-span-7 space-y-3">
                <div class="flex items-center justify-between px-1">
                    <h3 class="font-bold text-white text-sm sm:text-base flex items-center gap-2">
                        <i data-lucide="layers" class="w-4 h-4 text-sky-400"></i>
                        13 科目觀看進度
                    </h3>
                    <span class="text-[11px] text-slate-400">點選即可快速填寫</span>
                </div>

                <div id="course-grid" class="space-y-2.5">
                    <!-- Dynamic course items -->
                </div>
            </div>

        </div>

    </main>

    <!-- Mobile Floating Action Button (FAB) for Add Record -->
    <button onclick="quickOpenAddModal()" class="lg:hidden fixed right-4 bottom-20 z-20 w-12 h-12 rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 text-white shadow-xl shadow-sky-500/30 flex items-center justify-center active:scale-90 transition-transform">
        <i data-lucide="plus" class="w-6 h-6"></i>
    </button>

    <!-- Modal: Cross-Device Sync & Backup -->
    <div id="sync-modal" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl w-full max-w-md p-5 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <div class="flex items-center gap-2 text-sky-400">
                    <i data-lucide="arrow-left-right" class="w-5 h-5"></i>
                    <h3 class="font-bold text-white text-base">跨裝置同步與備份</h3>
                </div>
                <button onclick="closeSyncModal()" class="text-slate-400 hover:text-white p-1">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <p class="text-xs text-slate-400 leading-relaxed">
                您可以將電腦上的最新紀錄「複製同步碼」發送到手機貼上，或匯出 JSON 備份檔，實現多裝置進度一致！
            </p>

            <!-- Export / Copy Code -->
            <div class="space-y-2">
                <label class="block text-xs font-semibold text-slate-300">方法 1：複製文字同步碼（方便手機文字傳送）</label>
                <div class="flex gap-2">
                    <input type="text" id="sync-code-output" readonly class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs font-mono text-slate-300 overflow-hidden text-ellipsis">
                    <button onclick="copySyncCode()" class="px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-bold shrink-0 transition-colors">
                        複製
                    </button>
                </div>
            </div>

            <!-- Import Code -->
            <div class="space-y-2 pt-2 border-t border-slate-800">
                <label for="sync-code-input" class="block text-xs font-semibold text-slate-300">貼上同步碼匯入</label>
                <textarea id="sync-code-input" rows="2" placeholder="在此貼上同步碼..." class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs font-mono text-slate-200 focus:outline-none focus:border-sky-500"></textarea>
                <button onclick="importSyncCode()" class="w-full py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-sky-400 text-xs font-bold rounded-lg transition-colors">
                    匯入同步碼
                </button>
            </div>

            <!-- JSON Download / Upload -->
            <div class="pt-2 border-t border-slate-800 flex gap-2">
                <button onclick="exportJSON()" class="flex-1 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-medium rounded-lg flex items-center justify-center gap-1">
                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                    下載 JSON 檔
                </button>
                <label class="flex-1 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-medium rounded-lg flex items-center justify-center gap-1 cursor-pointer">
                    <i data-lucide="upload" class="w-3.5 h-3.5"></i>
                    上傳 JSON 檔
                    <input type="file" accept=".json" onchange="importJSON(event)" class="hidden">
                </label>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-slate-800/95 border border-slate-700 text-white text-xs px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 backdrop-blur-md">
        <i id="toast-icon" data-lucide="info" class="w-4 h-4 text-sky-400"></i>
        <span id="toast-msg">提示訊息</span>
    </div>

    <!-- Application JavaScript Logic -->
    <script>
        // Initial 13 subjects standard data
        const INITIAL_COURSES = [
            { id: 1, name: "刑法", total: 34, completed: 34 },
            { id: 2, name: "偵查法學", total: 12, completed: 12 },
            { id: 3, name: "中華民國憲法", total: 12, completed: 12 },
            { id: 4, name: "警察法規", total: 23, completed: 15 },
            { id: 5, name: "犯罪偵查", total: 9, completed: 1 },
            { id: 6, name: "警察情境實務", total: 10, completed: 2 },
            { id: 7, name: "刑事鑑識", total: 1, completed: 1 },
            { id: 8, name: "2026警特法條記憶班", total: 2, completed: 0 },
            { id: 9, name: "近兩年重要憲法判決整理", total: 2, completed: 2 },
            { id: 10, name: "刑法重要實務見解", total: 2, completed: 2 },
            { id: 11, name: "刑訴概說-證據法則", total: 1, completed: 1 },
            { id: 12, name: "刑訴概說-強制處分", total: 1, completed: 1 },
            { id: 13, name: "行政法從最高行政法院111年上675號判決 討論警察臨檢行為之性質與救濟方法之妥適性", total: 1, completed: 1 }
        ];

        let courses = [];
        let historyRecords = [];
        let activeMobileTab = 'courses'; // 'courses', 'record', 'history'

        window.onload = function() {
            loadFromStorage();
            setDefaultDate();
            renderAll();
            lucide.createIcons();
        };

        function setDefaultDate() {
            const dateInput = document.getElementById('record-date');
            const today = new Date().toISOString().split('T')[0];
            dateInput.value = today;
        }

        // LocalStorage Management
        function loadFromStorage() {
            const savedCourses = localStorage.getItem('online_course_data_v2');
            const savedHistory = localStorage.getItem('online_course_history_v2');

            courses = savedCourses ? JSON.parse(savedCourses) : JSON.parse(JSON.stringify(INITIAL_COURSES));
            historyRecords = savedHistory ? JSON.parse(savedHistory) : [];
        }

        function saveToStorage() {
            localStorage.setItem('online_course_data_v2', JSON.stringify(courses));
            localStorage.setItem('online_course_history_v2', JSON.stringify(historyRecords));
        }

        function confirmReset() {
            if (confirm("確定要重置所有進度回預設圖片狀態嗎？目前的觀看紀錄將會被清空。")) {
                courses = JSON.parse(JSON.stringify(INITIAL_COURSES));
                historyRecords = [];
                saveToStorage();
                renderAll();
                showToast("已恢復至初始預設進度！");
            }
        }

        // Render Functions
        function renderAll() {
            renderOverview();
            renderSelectOptions();
            renderCourses();
            renderHistory();
            lucide.createIcons();
        }

        function renderOverview() {
            let totalLessons = 0;
            let totalCompleted = 0;

            courses.forEach(c => {
                totalLessons += c.total;
                totalCompleted += c.completed;
            });

            const percent = totalLessons > 0 ? Math.round((totalCompleted / totalLessons) * 100) : 0;

            document.getElementById('total-completed').innerText = totalCompleted;
            document.getElementById('total-lessons').innerText = totalLessons;
            document.getElementById('total-percentage-text').innerText = `${percent}%`;
            document.getElementById('total-progress-bar').style.width = `${percent}%`;
        }

        function renderSelectOptions() {
            const select = document.getElementById('course-select');
            const currentSelected = select.value;
            select.innerHTML = '';

            courses.forEach(course => {
                const opt = document.createElement('option');
                opt.value = course.id;
                opt.textContent = `${course.name} (${course.completed}/${course.total}堂)`;
                select.appendChild(opt);
            });

            if (currentSelected) select.value = currentSelected;
        }

        function renderCourses() {
            const container = document.getElementById('course-grid');
            container.innerHTML = '';

            courses.forEach(course => {
                const percent = Math.min(100, Math.round((course.completed / course.total) * 100));
                const isFinished = course.completed >= course.total;

                const card = document.createElement('div');
                card.className = `glass-card rounded-xl p-3.5 transition-all cursor-pointer hover:border-slate-600 ${isFinished ? 'border-emerald-500/30 bg-emerald-950/10' : ''}`;
                card.onclick = () => selectCourseForLog(course.id);

                card.innerHTML = `
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <div class="flex items-center gap-2 min-w-0">
                            <div class="w-7 h-7 rounded-lg ${isFinished ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-800 text-sky-400'} flex items-center justify-center font-bold text-xs shrink-0">
                                <i data-lucide="${isFinished ? 'check-circle' : 'book-open'}" class="w-3.5 h-3.5"></i>
                            </div>
                            <h4 class="font-bold text-slate-100 text-xs sm:text-sm leading-snug truncate" title="${escapeHtml(course.name)}">
                                ${escapeHtml(course.name)}
                            </h4>
                        </div>
                        <div class="text-right shrink-0">
                            <span class="text-xs font-extrabold ${isFinished ? 'text-emerald-400' : 'text-sky-400'}">${course.completed}/${course.total}</span>
                            <span class="text-[10px] ${isFinished ? 'bg-emerald-500/20 text-emerald-300' : 'bg-slate-800 text-slate-300'} px-1.5 py-0.5 rounded ml-1 font-semibold">${percent}%</span>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="w-full bg-slate-900/80 rounded-full h-2 overflow-hidden border border-slate-800">
                        <div class="h-full rounded-full transition-all duration-300 ${isFinished ? 'bg-emerald-400' : 'bg-gradient-to-r from-sky-400 to-indigo-500'}" style="width: ${percent}%"></div>
                    </div>
                `;

                container.appendChild(card);
            });
        }

        function renderHistory() {
            const container = document.getElementById('history-list');
            const searchKeyword = document.getElementById('history-search').value.trim().toLowerCase();
            const countBadge = document.getElementById('history-count');

            const filteredRecords = historyRecords.filter(r => r.courseName.toLowerCase().includes(searchKeyword));
            countBadge.innerText = `${filteredRecords.length} 筆`;

            container.innerHTML = '';

            if (filteredRecords.length === 0) {
                container.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-center p-6 text-slate-500">
                        <i data-lucide="inbox" class="w-8 h-8 mb-1 stroke-1"></i>
                        <p class="text-xs">尚無觀看紀錄</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            filteredRecords.forEach(record => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between p-2.5 bg-slate-900/90 border border-slate-800 rounded-xl text-xs hover:border-slate-700 transition-all";

                item.innerHTML = `
                    <div class="space-y-0.5 pr-2 min-w-0">
                        <div class="flex items-center gap-1.5">
                            <span class="font-bold text-slate-200 truncate" title="${escapeHtml(record.courseName)}">${escapeHtml(record.courseName)}</span>
                            <span class="bg-sky-500/20 text-sky-300 border border-sky-500/30 px-1.5 py-0.2 rounded font-bold text-[10px]">+${record.count}堂</span>
                        </div>
                        <div class="text-[10px] text-slate-400 flex items-center gap-2">
                            <span>${record.date}</span>
                            <span>${record.timestamp}</span>
                        </div>
                    </div>
                    <button onclick="handleDeleteHistory(event, '${record.id}')" class="text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 p-1.5 rounded-lg transition-colors shrink-0" title="刪除紀錄並扣回堂數">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                `;

                container.appendChild(item);
            });

            lucide.createIcons();
        }

        // Add Record Event
        function handleAddRecord(e) {
            e.preventDefault();

            const courseId = parseInt(document.getElementById('course-select').value);
            const date = document.getElementById('record-date').value;
            const count = parseInt(document.getElementById('record-count').value);

            if (!courseId || !date || isNaN(count) || count <= 0) {
                showToast("請輸入正確的日期與堂數！");
                return;
            }

            const course = courses.find(c => c.id === courseId);
            if (!course) return;

            course.completed += count;

            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            const newRecord = {
                id: 'rec_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
                courseId: course.id,
                courseName: course.name,
                date: date,
                count: count,
                timestamp: timeStr
            };

            historyRecords.unshift(newRecord);
            saveToStorage();
            renderAll();

            document.getElementById('record-count').value = "1";
            showToast(`已新增《${course.name}》+${count} 堂紀錄！`);

            // On mobile, automatically switch back to courses list view after adding
            if (window.innerWidth < 1024) {
                switchMobileTab('courses');
            }
        }

        // Delete History Record
        function handleDeleteHistory(e, recordId) {
            e.stopPropagation();
            const index = historyRecords.findIndex(r => r.id === recordId);
            if (index === -1) return;

            const record = historyRecords[index];

            if (confirm(`確定刪除「${record.date} ${record.courseName} (+${record.count}堂)」這筆紀錄？\n科目進度將同步扣回。`)) {
                const course = courses.find(c => c.id === record.courseId);
                if (course) {
                    course.completed = Math.max(0, course.completed - record.count);
                }

                historyRecords.splice(index, 1);
                saveToStorage();
                renderAll();
                showToast("已刪除該筆紀錄並扣回進度！");
            }
        }

        // Quick Select Course from Card
        function selectCourseForLog(courseId) {
            document.getElementById('course-select').value = courseId;
            if (window.innerWidth < 1024) {
                switchMobileTab('record');
            } else {
                document.getElementById('record-count').focus();
            }
        }

        // Mobile Tab Switch Logic
        function switchMobileTab(tab) {
            activeMobileTab = tab;
            const leftSection = document.getElementById('section-left');
            const rightSection = document.getElementById('section-right');
            const formCard = document.getElementById('form-card');
            const historyCard = document.getElementById('history-card');

            // Reset tab button states
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`tab-btn-${tab}`).classList.add('active');

            if (tab === 'courses') {
                leftSection.classList.add('hidden');
                rightSection.classList.remove('hidden');
            } else if (tab === 'record') {
                leftSection.classList.remove('hidden');
                rightSection.classList.add('hidden');
                formCard.classList.remove('hidden');
                historyCard.classList.add('hidden');
            } else if (tab === 'history') {
                leftSection.classList.remove('hidden');
                rightSection.classList.add('hidden');
                formCard.classList.add('hidden');
                historyCard.classList.remove('hidden');
            }
        }

        function quickOpenAddModal() {
            switchMobileTab('record');
        }

        // Sync & Backup Modals & Export/Import
        function openSyncModal() {
            const dataPackage = {
                courses: courses,
                historyRecords: historyRecords,
                exportedAt: new Date().toISOString()
            };
            const code = btoa(unescape(encodeURIComponent(JSON.stringify(dataPackage))));
            document.getElementById('sync-code-output').value = code;

            const modal = document.getElementById('sync-modal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }

        function closeSyncModal() {
            const modal = document.getElementById('sync-modal');
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 200);
        }

        function copySyncCode() {
            const codeInput = document.getElementById('sync-code-output');
            codeInput.select();
            document.execCommand('copy');
            showToast("已複製同步碼！可在手機上貼上匯入");
        }

        function importSyncCode() {
            const code = document.getElementById('sync-code-input').value.trim();
            if (!code) {
                showToast("請先貼上同步碼！");
                return;
            }

            try {
                const decoded = decodeURIComponent(escape(atob(code)));
                const data = JSON.parse(decoded);

                if (data.courses && Array.isArray(data.courses)) {
                    courses = data.courses;
                    historyRecords = data.historyRecords || [];
                    saveToStorage();
                    renderAll();
                    closeSyncModal();
                    showToast("同步成功！已載入最新觀看進度");
                } else {
                    throw new Error("Invalid Format");
                }
            } catch(e) {
                showToast("同步碼格式無效，請確認複製內容完整。");
            }
        }

        function exportJSON() {
            const dataPackage = {
                courses: courses,
                historyRecords: historyRecords,
                version: '2.0',
                exportedAt: new Date().toLocaleString()
            };
            const blob = new Blob([JSON.stringify(dataPackage, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `網課紀錄備份_${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("已匯出備份 JSON 檔！");
        }

        function importJSON(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data.courses && Array.isArray(data.courses)) {
                        courses = data.courses;
                        historyRecords = data.historyRecords || [];
                        saveToStorage();
                        renderAll();
                        closeSyncModal();
                        showToast("已成功從 JSON 檔匯入紀錄！");
                    } else {
                        showToast("JSON 檔案格式不符合！");
                    }
                } catch(err) {
                    showToast("解析 JSON 檔失敗！");
                }
            };
            reader.readAsText(file);
        }

        // Toast Helper
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Helper: HTML Escape
        function escapeHtml(str) {
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
